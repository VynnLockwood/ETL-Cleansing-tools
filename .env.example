# Copy to .env and replace every value. Never commit .env.
# Passwords may contain any characters (e.g. from `openssl rand -base64`); the API and Superset encode them themselves.
POSTGRES_PASSWORD=change-me-postgres
SPP_OWNER_PASSWORD=change-me-owner
SPP_API_PASSWORD=change-me-api
SPP_READER_PASSWORD=change-me-reader
SUPERSET_DB_PASSWORD=change-me-superset-db
ADMIN_PASSWORD=change-me-admin
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-long-random-string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset-admin
SUPERSET_ADMIN_EMAIL=admin@example.com
